# Freqtrade Secrets Template
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git — only commit this .env.example file.
#
# Freqtrade reads secrets via FREQTRADE__SECTION__KEY env vars.
# These override the corresponding values in config.json at startup.
# See: https://www.freqtrade.io/en/stable/configuration/#environment-variables

# Telegram
FREQTRADE__TELEGRAM__TOKEN=your_telegram_bot_token_here
FREQTRADE__TELEGRAM__CHAT_ID=your_telegram_chat_id_here

# FreqUI / REST API
FREQTRADE__API_SERVER__JWT_SECRET_KEY=generate_a_random_64char_hex_string
FREQTRADE__API_SERVER__WS_TOKEN=generate_a_random_64char_hex_string
FREQTRADE__API_SERVER__USERNAME=your_frequi_username
FREQTRADE__API_SERVER__PASSWORD=your_frequi_password

# Binance API (leave empty for dry run, fill in for live trading)
FREQTRADE__EXCHANGE__KEY=
FREQTRADE__EXCHANGE__SECRET=

# Timezone (Docker container)
TZ=Europe/Athens
